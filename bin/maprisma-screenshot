#!/usr/bin/env bash
# Screenshot to ~/Pictures/Screenshots and the clipboard.
#   maprisma-screenshot          the focused screen
#   maprisma-screenshot region   a region picked with the mouse
#   maprisma-screenshot freeze   the same, with the screen frozen while picking
set -uo pipefail
mode=${1:-screen}
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"
freeze=
case $mode in
  screen)
    mon=$(hyprctl monitors -j | python3 -I -c 'import json,sys; print(next((m["name"] for m in json.load(sys.stdin) if m["focused"]), ""))')
    grim ${mon:+-o "$mon"} "$file" || exit 1 ;;
  region|freeze)
    if [[ $mode == freeze ]] && command -v hyprpicker >/dev/null; then
      hyprpicker -r -z >/dev/null 2>&1 & freeze=$!
      sleep 0.15
    fi
    geo=$(slurp -d) || { [[ -n $freeze ]] && kill "$freeze"; exit 0; }
    grim -g "$geo" "$file"; ok=$?
    [[ -n $freeze ]] && kill "$freeze"
    [[ $ok == 0 ]] || exit 1 ;;
  *) echo "usage: maprisma-screenshot [screen|region|freeze]" >&2; exit 2 ;;
esac
wl-copy --type image/png < "$file"
notify-send -a Screenshot -i "$file" "Screenshot saved" "${file/#$HOME/~} (also in the clipboard)"
